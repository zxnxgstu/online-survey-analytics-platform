PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=4h

DBHOST=localhost
DBPORT=3306
DBNAME=onlinevoting_db
DBUSER=root
DBPASS=your_database_password
# For Aiven/remote MySQL set DBSSL=true. Localhost is auto-detected as non-SSL.
DBSSL=false
# Optional path to a provider CA certificate. Defaults to backend/config/ca.pem when SSL is enabled.
DBCA=
DB_CONNECTION_LIMIT=10

# Comma-separated frontend origins. Empty = allow all origins (useful for local development).
CORS_ORIGINS=http://localhost:3000
